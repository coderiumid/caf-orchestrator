# Structural (non-secret) config — server port, Linear/GitHub API URLs, repo,
# workspace, queue, agent retries, OpenRouter routing, etc. — lives in
# caf.config.yaml (copy from caf.config.example.yaml), not here.

# Server
NODE_ENV=development
LOG_LEVEL=info

# Redis (required)
REDIS_URL=redis://localhost:6379

# Linear Integration (required)
LINEAR_WEBHOOK_SECRET=your-linear-webhook-secret
LINEAR_API_KEY=your-linear-api-key

# GitHub Integration (required for auto-PR creation)
GITHUB_TOKEN=your-github-token

# GitHub webhook secret (required — POST /webhooks/github, CAF-PRREVIEW-01
# Checkpoint B). Set the same value when configuring the repo webhook
# (Settings -> Webhooks -> Secret).
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Feature flags (default: true). Accepted values: true | false | 1 | 0
# Kept in .env (not caf.config.yaml) so it can be flipped without a
# structural-config redeploy during an incident.
ENABLE_PIPELINE_TRIGGER=true

# Dynamic agent skip (default: false). When true, the pipeline honors an
# explicit "## Skip Agents" section Planner can emit in tasks.md to skip
# frontend/backend/qa/reviewer/documentation for a ticket where they're not
# relevant. When false (default), every agent always runs — identical to
# pre-skip-feature behavior. See CLAUDE.md "Dynamic agent skip".
AGENT_SKIP_ENABLED=false

# Telegram notifications (optional — both required together or neither)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=your-chat-id

# OpenRouter routing for spawned agents (optional). Enable via
# caf.config.yaml's openai.useOpenai — if true, OPENAI_API_KEY is required.
# OPENAI_API_KEY=your-openrouter-api-key

# Claude Code CLI auth — required unless openai.useOpenai is true. This is
# currently the ONLY other valid auth path; startup fails without one or the
# other set. See CLAUDE.md "Per-agent model routing" section.
# CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token

# Bull Board dashboard basic-auth password (required if dashboard.enabled: true
# in caf.config.yaml). Username is set in caf.config.yaml (dashboard.basicAuthUser),
# not here.
# DASHBOARD_BASIC_AUTH_PASSWORD=your-strong-dashboard-password

# CAF_HEADLESS is NOT user-configurable — spawn-agent.service.ts always sets
# it to '1' on every spawned agent's env (and prepends an equivalent marker
# to the prompt text, for agents without a Bash tool). Do not set it here;
# any value would be overridden.
